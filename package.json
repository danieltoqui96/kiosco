{
  "name": "kiosco-desktop",
  "version": "1.0.0",
  "description": "Aplicacion de escritorio para inventario de kiosco",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cl.kiosco.desktop",
    "productName": "Inventario",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "backend/dist/**/*",
      "backend/package.json",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
